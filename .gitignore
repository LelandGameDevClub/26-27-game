# ==========================================
# Unity Generated / Cache Folders (in /game)
# ==========================================
/game/[Ll]ibrary/
/game/[Tt]emp/
/game/[Oo]bj/
/game/[Bb]uild/
/game/[Bb]uilds/
/game/[Ll]ogs/
/game/[Uu]ser[Ss]ettings/
/game/[Mm]emoryCaptures/

# ==========================================
# Asset Store & Package Management
# ==========================================
/game/AssetStoreTools*

# Ignore package cache, keep manifests
/game/[Pp]ackages/*
!/game/[Pp]ackages/manifest.json
!/game/[Pp]ackages/packages-lock.json

# ==========================================
# Gradle / Android Builds
# ==========================================
.gradle/
/game/[Aa]ssets/[Pp]lugins/Android/assets/

# ==========================================
# IDE & Code Editor Files
# ==========================================
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler & crash reports
sysinfo.txt
*.stackdump

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

