# ==========================================
# Unity Generated / Cache Folders (in /game)
# ==========================================
/Game/[Ll]ibrary/
/Game/[Tt]emp/
/Game/[Oo]bj/
/Game/[Bb]uild/
/Game/[Bb]uilds/
/Game/[Ll]ogs/
/Game/[Uu]ser[Ss]ettings/
/Game/[Mm]emoryCaptures/

# ==========================================
# Asset Store & Package Management
# ==========================================
/Game/AssetStoreTools*

# Ignore package cache, keep manifests
/Game/[Pp]ackages/*
!/Game/[Pp]ackages/manifest.json
!/Game/[Pp]ackages/packages-lock.json

# ==========================================
# Gradle / Android Builds
# ==========================================
.gradle/
/Game/[Aa]ssets/[Pp]lugins/Android/assets/

# ==========================================
# IDE & Code Editor Files
# ==========================================
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler & crash reports
sysinfo.txt
*.stackdump

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# ==========================================
# Critical Rule for Unity
# ==========================================
!*.meta
# ==========================================
# Unity build outputs & recorder output
